{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist/server",
    "rootDir": "./src/server",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@server/*": ["./src/server/*"]
    }
  },
  "include": ["src/server"],
  "exclude": ["node_modules"]
}
